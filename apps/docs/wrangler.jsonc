{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fault-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./doc_build",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
      {
          "pattern": "fault.thourum.com",
          "custom_domain": true
      }
  ]
}
